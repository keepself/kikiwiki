# docker-compose.prod.yml 가 읽는 실제 값들. 이 파일을 복사해서 .env.prod 로 저장하고 값을 채운 뒤 서버에만 둘 것 (git에 커밋 금지)
DB_USERNAME=kikiwiki
DB_PASSWORD=바꿔주세요
ADMIN_USERNAME=keepself
ADMIN_PASSWORD=바꿔주세요
JWT_SECRET=최소32자이상의무작위문자열로바꿔주세요
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# 마감기한/일정 알림 메일 발송용 (Gmail 앱 비밀번호 - 일반 로그인 비밀번호 아님)
MAIL_USERNAME=your-gmail@gmail.com
MAIL_APP_PASSWORD=구글계정에서발급받은16자리앱비밀번호
NOTIFICATION_EMAIL=알림받을이메일주소
# 운동 기록 AI 코칭용 (console.anthropic.com에서 발급). 비워두면 코칭 기능이 "미설정" 상태로만 동작
ANTHROPIC_API_KEY=
# 플레이스 장소 검색용 (developers.kakao.com에서 발급한 REST API 키). 비워두면 검색만 안 되고 나머지는 정상 동작
KAKAO_REST_API_KEY=
